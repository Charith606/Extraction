# ==============================================================================
# SYLLABUS EXTRACTOR & VERIFICATION STUDIO CONFIGURATION
# Copy this file to .env and insert your API keys.
# All fields are optional. If no keys are provided, it automatically runs in 
# 100% offline rule-based heuristic mode.
# ==============================================================================

# Primary & Secondary Providers: 'gemini', 'groq', 'openai', 'anthropic', 'deepseek', 'ollama', 'heuristic'
LLM_PRIMARY_PROVIDER=gemini
LLM_BACKUP_PROVIDER=groq

# 1. Google Gemini (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq (Free tier with ultra-fast inference at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Ollama (100% Free & Local at https://ollama.com)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 4. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 5. Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_PRIMARY_MODEL=claude-3-5-haiku-latest
CLAUDE_ESCALATION_MODEL=claude-3-5-sonnet-latest

# 6. DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Escalation Behavior
ENABLE_ESCALATION=true

# ==============================================================================
# BOOK AVAILABILITY & FREE LEGAL PDF DOWNLOAD CONFIGURATION
# ==============================================================================
# Polite User-Agent identifying your application to Open Library, Internet Archive, and Gutendex
USER_AGENT="SyllabusBookFinder/1.0 (Educational Academic Project; contact: student@example.edu)"

# Optional: Google Books API Key (increases rate limits from 429 Too Many Requests)
# Free key can be generated at https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# Network timeout in seconds for archive queries
REQUEST_TIMEOUT_SECONDS=10.0

